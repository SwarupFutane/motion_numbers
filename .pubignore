# What stays out of the pub.dev archive.
#
# Once this file exists, pub stops reading .gitignore for this directory, so
# every rule from .gitignore is repeated here. Keep the two in sync.

# --- Copied from .gitignore -------------------------------------------------
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
*.iml
*.ipr
*.iws
.idea/
.vscode/
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
.widget_preview/

# --- Publish-only ---------------------------------------------------------
# doc/*.webp is deliberately NOT excluded: every loop is a screenshot in
# pubspec.yaml, and a screenshot missing from the archive fails validation.

# CI configuration is repository plumbing, not package content.
/.github/
